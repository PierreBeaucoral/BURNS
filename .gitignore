# --- R / RStudio ---
.Rproj.user/
.Rhistory
.RData
.Ruserdata

# --- OS ---
.DS_Store

# --- Internal working notes: plans, journal, ideas memos (not for the public repo) ---
quality_reports/

# --- Data: raw snapshots are large & re-fetchable; keep manifests only ---
DATA/snapshots/*/
!DATA/snapshots/*/MANIFEST.md
DATA/cache/
DATA/effis_layer/

# --- Quarto / render artifacts ---
/.quarto/
_site/
*_files/
*.html
!assets/**/*.html

# --- Heavy generated media (re-renderable) ---
*.gif
# Exception: the post animations under assets/anim/. 2026-race.gif is built by
# scripts/build_race_anim.R, which `quarto render` does NOT call, so without
# committing it a fresh clone renders posts/2026.qmd with a broken image.
# ~1.4 MB total, and they are deterministic outputs of a pinned snapshot.
!assets/anim/*.gif

# --- Local-only working files ---
*.bak
index.rmarkdown

# --- graphify: publish the graph, keep machine-local derived state out ---
# graph.json / GRAPH_REPORT.md / manifest.json are the useful shared artifacts.
# The rest is either a machine path (.graphify_python), a content-hashed cache
# that churns on every update, or a dated backup of a previous graph.
graphify-out/.graphify_python
graphify-out/cache/
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/

# --- LaTeX side products (if any) ---
*.aux
*.log
*.toc

**/*.quarto_ipynb
